<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Jinasena_Invoicing security group
            ─────────────────────────────────
            Category  : Accounting (same as the built-in accounting groups)
            Inherits  : Accounting / Read-only
                        → members automatically get full read access to all
                          accounting models, journal entries, taxes, partners, etc.
            Extra rights added by this group (see ir.model.access.csv):
              • account.move           – read + write + create   (create & post invoices)
              • account.move.line      – read + write + create   (edit invoice lines)
              • account.move.send      – read + write + create   (send invoice by email/PDF)
              • account.payment.register – read + write + create (register payments)
              • sale.order             – read only               (view source SO)
              • sale.order.line        – read only               (view SO lines)
        -->
        <record id="group_jinasena_invoicing" model="res.groups">
            <field name="name">Jinasena_Invoicing</field>
            <field name="category_id" ref="base.module_category_accounting_accounting"/>
            <field name="implied_ids" eval="[(4, ref('account.group_account_readonly'))]"/>
        </record>

    </data>
</odoo>
